#!/bin/sh
#
# 提交前的前端硬闸：跑人体图纯规则自检（frontend/scripts/check-body-map.mjs）。
#
# 为什么要有这道闸：断言脚本本身是常驻的（`npm run check`），但没有任何东西会自动触发它——
# 一个"记得跑才跑"的守卫，在没人记得跑的那天就等于不存在。本仓库没有 CI，所以闸只能落在本地 hook。
#
# 为什么 hook 放在 .githooks/ 而不是 .git/hooks/：.git/hooks 只存在于本机，别人克隆下来就没有这道闸；
# 这个仓库是要展示的，闸得跟着仓库走。启用方式见 .githooks/README.md（一次性 `git config core.hooksPath .githooks`）。
#
# 为什么只在暂存区含 frontend/ 时才跑：只改后端却要等前端检查，很快就会有人 `--no-verify` 绕过，闸就废了。
#
# 只做一件事：调用既有的那一条命令，不在这里另写第二份断言逻辑。

# 只看会被提交的改动（新增/改动/改名/复制；删除不触发）
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -q '^frontend/'; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
script="$root/frontend/scripts/check-body-map.mjs"
if [ ! -f "$script" ]; then
  # 前端脚本还没落到这棵树上（例如从更早的分支提交），不拦。
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "✗ 找不到 node，无法跑前端人体图自检（npm run check）。" >&2
  echo "  装好 Node 后重试；确需绕过：git commit --no-verify" >&2
  exit 1
fi

if ! (cd "$root/frontend" && node scripts/check-body-map.mjs); then
  echo "" >&2
  echo "✗ 前端人体图自检未通过，提交已拒绝（失败条目见上）。" >&2
  echo "  自检命令：cd frontend && npm run check" >&2
  echo "  确认是误报才绕过：git commit --no-verify" >&2
  exit 1
fi

exit 0
