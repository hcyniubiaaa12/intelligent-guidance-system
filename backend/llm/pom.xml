<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guide</groupId>
        <artifactId>guide-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>llm</artifactId>
    <name>llm</name>
    <description>LLM 适配层：DeepSeek 对话 / 阿里 embedding / 阿里 rerank / 阿里 DocumentMind 文档解析；唯一外部模型出口</description>

    <dependencies>
        <dependency>
            <groupId>com.guide</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- DocumentMind 文档解析（链路 B：pdf/docx/png 的唯一解析路径，不降级）。
             tea-openapi / tea-util 等由它传递引入，不必显式声明；
             结果文件是 JSON，用已有的 Jackson 解析，不额外引 fastjson。 -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>docmind_api20220711</artifactId>
            <version>2.0.14</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
