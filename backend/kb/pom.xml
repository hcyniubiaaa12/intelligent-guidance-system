<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guide</groupId>
        <artifactId>guide-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>kb</artifactId>
    <name>kb</name>
    <description>链路 B：知识库管理、科室/文档/映射维护；唯一写向量库入口</description>

    <dependencies>
        <dependency>
            <groupId>com.guide</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- 入库流水线向量化：kb 是唯一写向量库入口，embedding 经 LLM 适配层（不直连第三方 API） -->
        <dependency>
            <groupId>com.guide</groupId>
            <artifactId>llm</artifactId>
        </dependency>
        <!-- 实现 rag 的 ChunkTextProvider 端口（依赖倒置：rag 不反向依赖 kb） -->
        <dependency>
            <groupId>com.guide</groupId>
            <artifactId>rag</artifactId>
        </dependency>
        <!-- 切分参数走 sys_config（检索 Top-K / 追问上限同源），与 chat 读配置是同一条路 -->
        <dependency>
            <groupId>com.guide</groupId>
            <artifactId>auth</artifactId>
        </dependency>
        <!-- Tika：**只接 html**。
             刻意只引 html 模块而不是 tika-parsers-standard-package——那个 bundle 会把
             pdf / poi / pdfbox 一起塞进 classpath，而「Tika 不得接 pdf/docx」是本项目的硬规则
             （降级路径平时不跑，只在故障时跑一次，产出没人验证过就进了知识库）。
             只引 html 模块，那条路**在依赖层面就不存在**，不靠人守纪律。 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-html-module</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
