# 私密配置模板：cp application.yml 同目录为 application-local.yml，填真实值（不提交）
# 该文件由 spring.profiles.active=local 叠加覆盖 application.yml

spring:
  datasource:
    password: real-mysql-password
  data:
    redis:
      password: real-redis-password

minio:
  access-key: real-minio-access-key
  secret-key: real-minio-secret-key

pgvector:
  password: real-pgvector-password

elasticsearch:
  password: real-es-password

jwt:
  secret: replace-with-at-least-32-chars-random-secret-key

llm:
  deepseek:
    api-key: sk-xxx
  dashscope:
    api-key: sk-xxx
  # 阿里云 DocumentMind（文档解析，走 llm 适配层）：pdf/docx/png 入库要用。
  # 也可以不填这里，改用同名环境变量 ALIBABA_CLOUD_ACCESS_KEY_ID / _SECRET
  docmind:
    access-key-id: LTAI-xxx
    access-key-secret: xxxx
